###########################################################################
# CarPlay Maps VC
# Baseline: omonob (QCDWJ)
# MU1427 + native route guidance: tomasz-twardzicki
###########################################################################
screen carplay-maps-vc Customization

keyValue
    value   String sys 0x00000000 0
    label   "CarPlay Maps VC"
    poll    0

keyValue
    value   String sys 0x00000000 0
    label   "Free open-source project"
    poll    0

keyValue
    value   String sys 0x00000000 0
    label   "Baseline author: omonob (QCDWJ)"
    poll    0

keyValue
    value   String sys 0x00000000 0
    label   "MU1427 author: tomasz-twardzicki"
    poll    0

keyValue
    value   String sys 0x00000000 0
    label   "MU1427: native arrows, distance and route totals"
    poll    0

script
    value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/cpmap_install_791.sh"
    label   "Install 791 AID 12.3 (AUTO MU)"

script
    value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/cpmap_install_790.sh"
    label   "Install 790 AID 10.5 (AUTO MU)"

script
    value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/cpmap_status.sh"
    label   "Show CarPlay Maps VC status"

script
    value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/cpmap_diag.sh"
    label   "Collect diagnostics to SD (Log/cpmap-diag-*)"

script
    value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/cpmap_restore.sh"
    label   "Restore factory files"

script
    value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/cpmap_guidance_install.sh"
    label   "Install full native guidance (MU1427 only)"

script
    value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/cpmap_guidance_status.sh"
    label   "Show native guidance status"

script
    value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/cpmap_guidance_disable.sh"
    label   "Disable native guidance now (until reboot)"

script
    value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/cpmap_guidance_remove.sh"
    label   "Remove native guidance (reboot)"
