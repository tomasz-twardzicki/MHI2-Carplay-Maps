#!/bin/sh

##
##SWDL Purpose RamDisk usage
##
info "lsd.sh called ..." 
##
##SWDL Purpose RamDisk usage
##
if [[ ${RUN_MODE} = "swdl" ]]; then

      RAM_DISK_SIZE=$(df -k /ramdisk | awk -F" " '{$1=$1; print $2}') 
      RAM_DISK_USED=$(df -k /ramdisk | awk -F" " '{$1=$1; print $3}')

      echo RamDiskSize:$RAM_DISK_SIZE
      echo RamDiskUsed:$RAM_DISK_USED


      WAS_ERROR=0

      echo "RAM_DISK is in SWDL Mode, copying data..."

      echo "Removing possible old contents"
      rm -rf /ramdisk/hmi
      cp -c -R -l 0 /mnt/app/eso/hmi/lsd/* /ramdisk/hmi/lsd
      ERROR_CODE=$?
      if [ $ERROR_CODE !=  0 ]; then
            WAS_ERROR=1
      fi

      echo "Copy config"
      cp -c -R /mnt/app/eso/hmi/lsd/config /ramdisk/hmi/lsd/config
      ERROR_CODE=$?
      if [ $ERROR_CODE !=  0 ]; then
            WAS_ERROR=1
       fi

      echo "Copy hmi"
       cp -c -R /mnt/app/eso/hmi/lsd/hmi /ramdisk/hmi/lsd/hmi
      ERROR_CODE=$?

      if [ $ERROR_CODE !=  0 ]; then
            WAS_ERROR=1
      fi

      echo "Copy JXE"
     ln -s /ifs/ /ramdisk/ifs
      ERROR_CODE=$?

      if [ $ERROR_CODE !=  0 ]; then
            WAS_ERROR=1
       fi

      echo "Copy jars"
       cp -c -R /mnt/app/eso/hmi/lsd/jars /ramdisk/hmi/lsd/jars
      ERROR_CODE=$?
      if [ $ERROR_CODE !=  0 ]; then
            WAS_ERROR=1
      fi

      echo "Copy lib"
      cp -c -R /mnt/app/eso/hmi/lsd/lib /ramdisk/hmi/lsd/lib

      echo "Copy res"
      cp -c -R /mnt/app/eso/hmi/lsd/res /ramdisk/hmi/lsd/res
       ERROR_CODE=$?
      if [ $ERROR_CODE !=  0 ]; then
            WAS_ERROR=1
      fi

      echo "Copy skin resources"
      cp -c -R /mnt/app/eso/hmi/lsd/Resources /ramdisk/hmi/lsd/Resources
      ERROR_CODE=$?
      if [ $ERROR_CODE !=  0 ]; then
            WAS_ERROR=1
       fi
  
       if [ $WAS_ERROR ==  1 ]; then
            echo "RAM_DISK error on copy for SWDL, starting HMI normally..."
            export BASE_DIR=$MOUNT_DIR/eso/hmi
            export IFS_DIR=/ifs
      else
            echo "RAM_DISK is ready for SWDL, starting HMI from RamDisk for SWDL..."
            VMOPTIONS="$VMOPTIONS -Dspi.resourcepath=/ramdisk/hmi/lsd/Resources"
            export BASE_DIR=/ramdisk/hmi
            export IFS_DIR=/ramdisk/ifs
      fi
else 
      echo "RUN_MODE != SWDL detected starting HMI normally..."
      export BASE_DIR=$MOUNT_DIR/eso/hmi
      export IFS_DIR=/ifs
fi



